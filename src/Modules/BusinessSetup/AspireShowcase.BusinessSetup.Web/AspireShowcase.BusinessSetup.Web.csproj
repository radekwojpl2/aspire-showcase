<Project Sdk="Microsoft.NET.Sdk">

  <!-- Business Setup's endpoints: each one hands its request to a use case in Application and
       turns the result into an HTTP answer. Never touches storage. Public: MapBusinessSetup. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspireShowcase.BusinessSetup.Application\AspireShowcase.BusinessSetup.Application.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\AspireShowcase.BuildingBlocks.Web\AspireShowcase.BuildingBlocks.Web.csproj" />
    <ProjectReference Include="..\..\Identity\AspireShowcase.Identity\AspireShowcase.Identity.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The web types endpoints use; the Web SDK would import them itself. -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
  </ItemGroup>

</Project>
