<Project Sdk="Microsoft.NET.Sdk">

  <!-- Business Setup's use cases: one handler each, working on the domain through
       IBusinessSetupDbContext. No ASP.NET Core, no PostgreSQL. Internal: only the module's own
       projects and tests see it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspireShowcase.BusinessSetup.Domain\AspireShowcase.BusinessSetup.Domain.csproj" />
    <ProjectReference Include="..\AspireShowcase.BusinessSetup.PublicClient\AspireShowcase.BusinessSetup.PublicClient.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\AspireShowcase.BuildingBlocks.Application\AspireShowcase.BuildingBlocks.Application.csproj" />
    <ProjectReference Include="..\..\Identity\AspireShowcase.Identity.PublicClient\AspireShowcase.Identity.PublicClient.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="AspireShowcase.BusinessSetup.Domain" />
    <Using Include="AspireShowcase.BuildingBlocks.Application" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AspireShowcase.BusinessSetup.Infrastructure" />
    <InternalsVisibleTo Include="AspireShowcase.BusinessSetup.Web" />
    <InternalsVisibleTo Include="AspireShowcase.BusinessSetup.Tests" />
  </ItemGroup>

</Project>
