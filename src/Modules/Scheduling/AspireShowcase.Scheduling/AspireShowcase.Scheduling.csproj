<Project Sdk="Microsoft.NET.Sdk">

  <!-- Scheduling: bookings and, later, availability. Public: AddScheduling, MapScheduling and
       MigrateSchedulingAsync; the domain model and its storage are internal. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" Version="13.6.0" />
    <PackageReference Include="MassTransit" Version="8.5.11" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.5.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- Business Setup only through its public client, never the module itself. -->
    <ProjectReference Include="..\..\BusinessSetup\AspireShowcase.BusinessSetup.PublicClient\AspireShowcase.BusinessSetup.PublicClient.csproj" />
    <ProjectReference Include="..\..\Identity\AspireShowcase.Identity\AspireShowcase.Identity.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\AspireShowcase.BuildingBlocks.Domain\AspireShowcase.BuildingBlocks.Domain.csproj" />
    <ProjectReference Include="..\AspireShowcase.Scheduling.PublicClient\AspireShowcase.Scheduling.PublicClient.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\AspireShowcase.BuildingBlocks.Infrastructure\AspireShowcase.BuildingBlocks.Infrastructure.csproj" />
    <ProjectReference Include="..\AspireShowcase.Scheduling.Domain\AspireShowcase.Scheduling.Domain.csproj" />
    <ProjectReference Include="..\AspireShowcase.Scheduling.Application\AspireShowcase.Scheduling.Application.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\AspireShowcase.BuildingBlocks.Web\AspireShowcase.BuildingBlocks.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The web types endpoints and registration use; the Web SDK would import them itself. -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="AspireShowcase.Scheduling.Domain" />
  </ItemGroup>

  <ItemGroup>
    <!-- The domain rules are tested directly. -->
    <InternalsVisibleTo Include="AspireShowcase.Scheduling.Tests" />
  </ItemGroup>

</Project>
