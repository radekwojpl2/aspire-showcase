<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The host: composes the modules in src/Modules and serves their endpoints as "web". -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <!-- The startup project for `dotnet ef`, which needs this; the migrations live in the modules. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.2" />
    <PackageReference Include="Swashbuckle.AspNetCore.SwaggerUI" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AspireShowcase.ServiceDefaults\AspireShowcase.ServiceDefaults.csproj" />
    <ProjectReference Include="..\Modules\AspireShowcase.BusinessSetup\AspireShowcase.BusinessSetup.csproj" />
    <ProjectReference Include="..\Modules\AspireShowcase.Identity\AspireShowcase.Identity.csproj" />
    <ProjectReference Include="..\Modules\AspireShowcase.Scheduling\AspireShowcase.Scheduling.csproj" />
  </ItemGroup>

</Project>
