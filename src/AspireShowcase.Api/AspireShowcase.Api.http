@AspireShowcase.Api_HostAddress = http://localhost:5268

# Calls web directly, so it needs an access token for the API resource: bff adds one when
# the React app calls through it, but never hands it to the browser.
@AccessToken = <access-token>

GET {{AspireShowcase.Api_HostAddress}}/api/businesses/mine
Authorization: Bearer {{AccessToken}}

###

GET {{AspireShowcase.Api_HostAddress}}/api/businesses/slug-availability?slug=anna-hair
Authorization: Bearer {{AccessToken}}

###

POST {{AspireShowcase.Api_HostAddress}}/api/businesses
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{ "name": "Anna's Hair", "slug": "anna-hair", "timeZone": "Europe/Warsaw", "ownerName": "Anna" }

###

# Opening hours need the owner role (the manage:business permission).
GET {{AspireShowcase.Api_HostAddress}}/api/businesses/mine/opening-hours
Authorization: Bearer {{AccessToken}}

###

PUT {{AspireShowcase.Api_HostAddress}}/api/businesses/mine/opening-hours
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "timeZone": "Europe/Warsaw",
  "periods": [
    { "day": "monday", "opens": "09:00", "closes": "12:00" },
    { "day": "monday", "opens": "13:00", "closes": "17:00" },
    { "day": "saturday", "opens": "10:00", "closes": "14:00" }
  ]
}

###

# Services also need the owner role.
GET {{AspireShowcase.Api_HostAddress}}/api/businesses/mine/services
Authorization: Bearer {{AccessToken}}

###

POST {{AspireShowcase.Api_HostAddress}}/api/businesses/mine/services
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{ "name": "Haircut", "durationMinutes": 45, "price": 120, "currency": "PLN" }

###

# Staff too. Without workingHours, they work whenever the business is open.
GET {{AspireShowcase.Api_HostAddress}}/api/businesses/mine/staff
Authorization: Bearer {{AccessToken}}

###

POST {{AspireShowcase.Api_HostAddress}}/api/businesses/mine/staff
Content-Type: application/json
Authorization: Bearer {{AccessToken}}

{
  "name": "Ben",
  "doesAllServices": true,
  "workingHours": [
    { "day": "monday", "opens": "09:00", "closes": "13:00" }
  ]
}

###

# The calendar: view=day or week, date as yyyy-MM-dd (default: today, in the business's time zone).
GET {{AspireShowcase.Api_HostAddress}}/api/businesses/mine/bookings?view=week
Authorization: Bearer {{AccessToken}}

###
