<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the modules' boundaries on the compiled assemblies: who references whom, and what
       each one makes public. Every project under src/Modules is referenced, so each one is checked
       even before the API host uses it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Where src/Modules is, wherever the tests are built. -->
    <AssemblyMetadata Include="RepositoryRoot" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\**\*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shows test names as sentences: underscores become spaces. -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
